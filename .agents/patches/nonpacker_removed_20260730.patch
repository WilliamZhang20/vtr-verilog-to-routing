+/**
+ * @brief Optional on-disk place-delay cache (env VPR_PLACE_DELAY_CACHE=<path>).
+ *
+ * When set, and CLI read/write_placement_delay_lookup are empty:
+ *  - if <path> exists → read (skip compute)
+ *  - else → compute then write
+ *
+ * Pure reuse of the timing lookup used by GP/SA — does not change packer or
+ * SA schedules. Safe across nest/b2b arms that share arch+device+W.
+ */
+void apply_place_delay_cache_env(t_placer_opts& placer_opts) {
+    if (!placer_opts.read_placement_delay_lookup.empty()
+        || !placer_opts.write_placement_delay_lookup.empty()) {
+        return; // explicit CLI wins
+    }
+    const char* path = std::getenv("VPR_PLACE_DELAY_CACHE");
+    if (!path || path[0] == '\0') {
+        return;
+    }
+    namespace fs = std::filesystem;
+    if (fs::exists(path)) {
+        placer_opts.read_placement_delay_lookup = path;
+        VTR_LOG("VPR_PLACE_DELAY_CACHE: reading place-delay lookup from %s\n", path);
+    } else {
+        placer_opts.write_placement_delay_lookup = path;
+        VTR_LOG("VPR_PLACE_DELAY_CACHE: will write place-delay lookup to %s\n", path);
+    }
+}
+
+} // namespace
